# Set these in Railway Variables, never in frontend VITE_* variables.
WEB_MODE=true
DEBUG=false
COOKIE_SECURE=true
APP_VERSION=0.2.0-beta.2
MIGRATION_HEAD=a1b2c3d4e5f6
WEB_SESSION_HOURS=12
WEB_MAX_USERS=3
# Replace the hostname with the generated Railway application hostname.
TRUSTED_HOSTS=YOUR-SERVICE.up.railway.app,healthcheck.railway.app
# Reference the NEW Railway PostgreSQL service's private connection URL.
DATABASE_URL=
# Generate one administrator invite and two tester invites before first migration.
WEB_ADMIN_INVITE_CODE=
WEB_INVITE_CODES=
